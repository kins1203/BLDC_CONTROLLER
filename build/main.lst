 218:Core/Src/main.c ****   len += vsnprintf(buf + len, CDC_LOG_BUF_SIZE - len, fmt, args);
 219:Core/Src/main.c ****   va_end(args);
 220:Core/Src/main.c **** 
 221:Core/Src/main.c ****   /* Kết thúc dòng */
 222:Core/Src/main.c ****   len += snprintf(buf + len, CDC_LOG_BUF_SIZE - len, "\r\n");
 223:Core/Src/main.c **** 
 224:Core/Src/main.c ****   /* Gửi qua USB CDC */
 225:Core/Src/main.c ****   if (len > 0)
 226:Core/Src/main.c ****   {
 227:Core/Src/main.c ****     CDC_Transmit_FS((uint8_t *)buf, len);
 228:Core/Src/main.c ****   }
 229:Core/Src/main.c **** }
 230:Core/Src/main.c **** void Motor_Hall_SVPWM_Run(void)
 231:Core/Src/main.c **** {
 232:Core/Src/main.c ****   hall = Hall_ReadABC();
 233:Core/Src/main.c ****   int8_t sector = hall_to_sector[hall];
 234:Core/Src/main.c **** 
 235:Core/Src/main.c ****   if (sector < 0)
 236:Core/Src/main.c ****   {
 237:Core/Src/main.c ****     /* Hall lỗi (000 hoặc 111) → tắt PWM cho an toàn */
 238:Core/Src/main.c ****     __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
 239:Core/Src/main.c ****     __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
 240:Core/Src/main.c ****     __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, 0);
 241:Core/Src/main.c ****     return;
 242:Core/Src/main.c ****   }
 243:Core/Src/main.c **** 
 244:Core/Src/main.c ****   /* Góc điện trung tâm sector */
 245:Core/Src/main.c ****   angle = sector_angle[sector];
 246:Core/Src/main.c ****   /* wrap về 0..2π */
 247:Core/Src/main.c ****   if (angle >= 2.0f * M_PI)
 248:Core/Src/main.c ****     angle -= 2.0f * M_PI;
 249:Core/Src/main.c ****   /* Vector điện áp */
 250:Core/Src/main.c ****   float Ualpha = hall_voltage * cosf(angle);
 251:Core/Src/main.c ****   float Ubeta = hall_voltage * sinf(angle);
 252:Core/Src/main.c **** 
 253:Core/Src/main.c ****   /* SVPWM */
 254:Core/Src/main.c ****   float dutyA, dutyB, dutyC;
 255:Core/Src/main.c ****   SVPWM_Compute(&hsvpwm, Ualpha, Ubeta, &dutyA, &dutyB, &dutyC);
 256:Core/Src/main.c **** 
 257:Core/Src/main.c ****   /* Xuất PWM */
 258:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, dutyA * hsvpwm.pwm_period);
ARM GAS  C:\Users\ACER\AppData\Local\Temp\ccJnZfJG.s 			page 6


 259:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, dutyB * hsvpwm.pwm_period);
 260:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, dutyC * hsvpwm.pwm_period);
 261:Core/Src/main.c ****   CDC_Log("a=%.2f, b=%.2f,c=%.2f", dutyA / 3.0f, dutyB / 3.0f, dutyC / 3.0f);
 262:Core/Src/main.c **** }
 263:Core/Src/main.c **** 
 264:Core/Src/main.c **** void Motor_OpenLoop_SVPWM_Run(void)
 265:Core/Src/main.c **** {
 266:Core/Src/main.c ****   uint32_t now = HAL_GetTick();
 267:Core/Src/main.c ****   float dt = (now - last_tick) * 0.001f; // ms → s
 268:Core/Src/main.c ****   last_tick = now;
 269:Core/Src/main.c **** 
 270:Core/Src/main.c ****   /* 1. cập nhật góc điện */
 271:Core/Src/main.c ****   elec_angle += OPENLOOP_SPEED * dt;
 272:Core/Src/main.c ****   if (elec_angle > TWO_PI)
 273:Core/Src/main.c ****     elec_angle -= TWO_PI;
 274:Core/Src/main.c **** 
 275:Core/Src/main.c ****   /* 2. tạo vector điện áp */
 276:Core/Src/main.c ****   float Ualpha = OPENLOOP_VOLTAGE * cosf(elec_angle);
 277:Core/Src/main.c ****   float Ubeta = OPENLOOP_VOLTAGE * sinf(elec_angle);
 278:Core/Src/main.c **** 
 279:Core/Src/main.c ****   /* 3. SVPWM */
 280:Core/Src/main.c ****   float dutyA, dutyB, dutyC;
 281:Core/Src/main.c ****   SVPWM_Compute(&hsvpwm, Ualpha, Ubeta, &dutyA, &dutyB, &dutyC);
 282:Core/Src/main.c **** 
 283:Core/Src/main.c ****   /* 4. xuất PWM */
 284:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, dutyA * hsvpwm.pwm_period);
 285:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, dutyB * hsvpwm.pwm_period);
 286:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, dutyC * hsvpwm.pwm_period);
 287:Core/Src/main.c ****   CDC_Log("a=%.2f, b=%.2f,c=%.2f", dutyA / 3.0f, dutyB / 3.0f, dutyC / 3.0f);
 288:Core/Src/main.c **** }
