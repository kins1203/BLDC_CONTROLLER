 207:Core/Src/main.c **** void CDC_Log(const char *fmt, ...)
 208:Core/Src/main.c **** {
 209:Core/Src/main.c ****   static char buf[CDC_LOG_BUF_SIZE];
 210:Core/Src/main.c ****   int len = 0;
 211:Core/Src/main.c **** 
 212:Core/Src/main.c ****   /* Prefix */
 213:Core/Src/main.c ****   len += snprintf(buf + len, CDC_LOG_BUF_SIZE - len, "LOG, ");
 214:Core/Src/main.c **** 
 215:Core/Src/main.c ****   /* Format nội dung */
 216:Core/Src/main.c ****   va_list args;
