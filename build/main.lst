 546:Core/Src/main.c **** int parse_float_dot(const char *s, float *out)
 547:Core/Src/main.c **** {
 548:Core/Src/main.c ****   int sign = 1;
 549:Core/Src/main.c ****   int ipart = 0;
 550:Core/Src/main.c ****   int dpart = 0;
 551:Core/Src/main.c ****   float dscale = 1.0f;
 552:Core/Src/main.c ****   int has_digit = 0;
 553:Core/Src/main.c **** 
 554:Core/Src/main.c ****   /* skip space */
 555:Core/Src/main.c ****   while (*s == ' ' || *s == '\r' || *s == '\n')
 556:Core/Src/main.c ****     s++;
 557:Core/Src/main.c **** 
 558:Core/Src/main.c ****   /* sign */
 559:Core/Src/main.c ****   if (*s == '-')
 560:Core/Src/main.c ****   {
 561:Core/Src/main.c ****     sign = -1;
 562:Core/Src/main.c ****     s++;
 563:Core/Src/main.c ****   }
 564:Core/Src/main.c ****   else if (*s == '+')
 565:Core/Src/main.c ****   {
 566:Core/Src/main.c ****     s++;
 567:Core/Src/main.c ****   }
 568:Core/Src/main.c **** 
 569:Core/Src/main.c ****   /* integer part */
 570:Core/Src/main.c ****   while (isdigit((unsigned char)*s))
 571:Core/Src/main.c ****   {
 572:Core/Src/main.c ****     ipart = ipart * 10 + (*s - '0');
 573:Core/Src/main.c ****     has_digit = 1;
 574:Core/Src/main.c ****     s++;
 575:Core/Src/main.c ****   }
 576:Core/Src/main.c **** 
 577:Core/Src/main.c ****   /* decimal part */
 578:Core/Src/main.c ****   if (*s == '.')
 579:Core/Src/main.c ****   {
 580:Core/Src/main.c ****     s++;
 581:Core/Src/main.c ****     while (isdigit((unsigned char)*s))
 582:Core/Src/main.c ****     {
 583:Core/Src/main.c ****       dpart = dpart * 10 + (*s - '0');
 584:Core/Src/main.c ****       dscale *= 0.1f;
 585:Core/Src/main.c ****       has_digit = 1;
 586:Core/Src/main.c ****       s++;
 587:Core/Src/main.c ****     }
 588:Core/Src/main.c ****   }
 589:Core/Src/main.c **** 
 590:Core/Src/main.c ****   if (!has_digit)
 591:Core/Src/main.c ****     return 0; // parse fail
 592:Core/Src/main.c **** 
 593:Core/Src/main.c ****   *out = sign * (ipart + dpart * dscale);
 594:Core/Src/main.c ****   return 1; // parse OK
ARM GAS  C:\Users\ACER\AppData\Local\Temp\ccJnZfJG.s 			page 15


 595:Core/Src/main.c **** }
