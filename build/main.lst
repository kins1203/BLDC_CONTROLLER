 301:Core/Src/main.c **** float Motor_Calib_HallOffset(void)
 302:Core/Src/main.c **** {
 303:Core/Src/main.c ****   uint8_t hall;
 304:Core/Src/main.c ****   int8_t sector;
 305:Core/Src/main.c ****   float offset;
 306:Core/Src/main.c **** 
 307:Core/Src/main.c ****   CDC_Log("HALL CALIB START");
 308:Core/Src/main.c **** 
 309:Core/Src/main.c ****   /* 1. Khóa rotor tại góc điện 0° */
ARM GAS  C:\Users\ACER\AppData\Local\Temp\ccJnZfJG.s 			page 10


 310:Core/Src/main.c ****   Motor_Lock_ElectricalAngle(0.0f);
 311:Core/Src/main.c ****   HAL_Delay(CALIB_DELAY_MS);
 312:Core/Src/main.c **** 
 313:Core/Src/main.c ****   /* 2. Đọc Hall */
 314:Core/Src/main.c ****   hall = Hall_ReadABC();
 315:Core/Src/main.c ****   sector = hall_to_sector[hall];
 316:Core/Src/main.c **** 
 317:Core/Src/main.c ****   if (sector < 0)
 318:Core/Src/main.c ****   {
 319:Core/Src/main.c ****     CDC_Log("HALL CALIB FAIL, hall=%d", hall);
 320:Core/Src/main.c ****     return 0.0f;
 321:Core/Src/main.c ****   }
 322:Core/Src/main.c **** 
 323:Core/Src/main.c ****   /* 3. Tính offset:
 324:Core/Src/main.c ****    * Ta muốn angle + offset = center của sector
 325:Core/Src/main.c ****    * center = sector * 60° + 30°
 326:Core/Src/main.c ****    */
 327:Core/Src/main.c ****   offset = (sector * (M_PI / 3.0f)) + (M_PI / 6.0f);
 328:Core/Src/main.c **** 
 329:Core/Src/main.c ****   /* 4. Wrap về 0..2π */
 330:Core/Src/main.c ****   if (offset >= TWO_PI)
 331:Core/Src/main.c ****     offset -= TWO_PI;
 332:Core/Src/main.c **** 
 333:Core/Src/main.c ****   CDC_Log("HALL CALIB OK, hall=%d sector=%d offset=%.1f deg",
 334:Core/Src/main.c ****           hall,
 335:Core/Src/main.c ****           sector,
 336:Core/Src/main.c ****           offset * 180.0f / M_PI);
 337:Core/Src/main.c **** 
 338:Core/Src/main.c ****   return offset;
 339:Core/Src/main.c **** }
 340:Core/Src/main.c **** float Encoder_GetAngleRad(void)
 341:Core/Src/main.c **** {
 342:Core/Src/main.c ****   return AS5600_GetAngleRad(&as5600); // 0..2PI
 343:Core/Src/main.c **** }
 344:Core/Src/main.c **** 
 345:Core/Src/main.c **** float Encoder_GetSpeedRad(void)
 346:Core/Src/main.c **** {
 347:Core/Src/main.c ****   float dtheta;
 348:Core/Src/main.c **** 
 349:Core/Src/main.c ****   mech_angle = Encoder_GetAngleRad();
 350:Core/Src/main.c ****   dtheta = mech_angle - mech_angle_prev;
 351:Core/Src/main.c **** 
 352:Core/Src/main.c ****   /* unwrap */
 353:Core/Src/main.c ****   if (dtheta > M_PI)
 354:Core/Src/main.c ****     dtheta -= 2.0f * M_PI;
 355:Core/Src/main.c ****   if (dtheta < -M_PI)
 356:Core/Src/main.c ****     dtheta += 2.0f * M_PI;
 357:Core/Src/main.c **** 
 358:Core/Src/main.c ****   mech_speed = dtheta / DT_CTRL;
 359:Core/Src/main.c ****   mech_angle_prev = mech_angle;
 360:Core/Src/main.c **** 
 361:Core/Src/main.c ****   return mech_speed;
 362:Core/Src/main.c **** }
 363:Core/Src/main.c **** #define CALIB_VOLTAGE 5.0f
 364:Core/Src/main.c **** #define CALIB_DELAY_MS 500
 365:Core/Src/main.c **** typedef struct
 366:Core/Src/main.c **** {
ARM GAS  C:\Users\ACER\AppData\Local\Temp\ccJnZfJG.s 			page 11


 367:Core/Src/main.c ****   float kp, ki;
 368:Core/Src/main.c ****   float integral;
 369:Core/Src/main.c **** } PID_t;
 370:Core/Src/main.c **** 
 371:Core/Src/main.c **** PID_t pid_speed = {
 372:Core/Src/main.c ****     .kp = 0.02f,
 373:Core/Src/main.c ****     .ki = 0.5f,
 374:Core/Src/main.c ****     .integral = 0.0f};
 375:Core/Src/main.c **** 
 376:Core/Src/main.c **** float PID_Speed_Run(PID_t *pid, float ref, float fb)
 377:Core/Src/main.c **** {
 378:Core/Src/main.c ****   float err = ref - fb;
 379:Core/Src/main.c **** 
 380:Core/Src/main.c ****   pid->integral += err * DT_CTRL;
 381:Core/Src/main.c **** 
 382:Core/Src/main.c ****   float out = pid->kp * err + pid->ki * pid->integral;
 383:Core/Src/main.c **** 
 384:Core/Src/main.c ****   /* clamp */
 385:Core/Src/main.c ****   if (out > UQ_MAX)
 386:Core/Src/main.c ****     out = UQ_MAX;
 387:Core/Src/main.c ****   if (out < -UQ_MAX)
 388:Core/Src/main.c ****     out = -UQ_MAX;
 389:Core/Src/main.c **** 
 390:Core/Src/main.c ****   return out;
 391:Core/Src/main.c **** }
 392:Core/Src/main.c **** void Motor_SpeedControl_Loop(void)
 393:Core/Src/main.c **** {
 394:Core/Src/main.c ****   /* 1. speed feedback */
 395:Core/Src/main.c ****   float speed_fb = Encoder_GetSpeedRad();
 396:Core/Src/main.c **** 
 397:Core/Src/main.c ****   /* 2. PID */
 398:Core/Src/main.c ****   Uq = PID_Speed_Run(&pid_speed, speed_ref, speed_fb);
 399:Core/Src/main.c **** 
 400:Core/Src/main.c ****   /* 3. electrical angle */
 401:Core/Src/main.c ****   elec_angle = POLE_PAIRS * mech_angle + elec_offset;
 402:Core/Src/main.c **** 
 403:Core/Src/main.c ****   if (elec_angle > 2.0f * M_PI)
 404:Core/Src/main.c ****     elec_angle -= 2.0f * M_PI;
 405:Core/Src/main.c **** 
 406:Core/Src/main.c ****   /* 4. SVPWM (Id = 0) */
 407:Core/Src/main.c ****   float Ualpha = -Uq * sinf(elec_angle);
 408:Core/Src/main.c ****   float Ubeta = Uq * cosf(elec_angle);
 409:Core/Src/main.c **** 
 410:Core/Src/main.c ****   float dA, dB, dC;
 411:Core/Src/main.c ****   SVPWM_Compute(&hsvpwm, Ualpha, Ubeta, &dA, &dB, &dC);
 412:Core/Src/main.c **** 
 413:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, dA * hsvpwm.pwm_period);
 414:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, dB * hsvpwm.pwm_period);
 415:Core/Src/main.c ****   __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, dC * hsvpwm.pwm_period);
 416:Core/Src/main.c **** }
