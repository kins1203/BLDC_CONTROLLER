 167:Core/Src/main.c **** /* Hall ABC -> sector (0..5) */
 168:Core/Src/main.c **** static const int8_t hall_to_sector[8] =
 169:Core/Src/main.c ****     {
 170:Core/Src/main.c ****         -1, // 000 invalid
 171:Core/Src/main.c ****         0,  // 001
 172:Core/Src/main.c ****         4,  // 010
 173:Core/Src/main.c ****         5,  // 011
 174:Core/Src/main.c ****         2,  // 100
 175:Core/Src/main.c ****         1,  // 101
 176:Core/Src/main.c ****         3,  // 110
 177:Core/Src/main.c ****         -1  // 111 invalid
 178:Core/Src/main.c **** };
 179:Core/Src/main.c **** /* Góc giữa mỗi sector 60° */
 180:Core/Src/main.c **** static const float sector_angle[12] =
 181:Core/Src/main.c ****     {
 182:Core/Src/main.c ****         0.0f,                // 0
 183:Core/Src/main.c ****         M_PI / 6.0f,         // 30
 184:Core/Src/main.c ****         M_PI / 3.0f,         // 60
 185:Core/Src/main.c ****         M_PI / 2.0f,         // 90
 186:Core/Src/main.c ****         2.0f * M_PI / 3.0f,  // 120
 187:Core/Src/main.c ****         5.0f * M_PI / 6.0f,  // 150
 188:Core/Src/main.c ****         M_PI,                // 180
 189:Core/Src/main.c ****         7.0f * M_PI / 6.0f,  // 210
 190:Core/Src/main.c ****         4.0f * M_PI / 3.0f,  // 240
 191:Core/Src/main.c ****         3.0f * M_PI / 2.0f,  // 270
 192:Core/Src/main.c ****         5.0f * M_PI / 3.0f,  // 300
 193:Core/Src/main.c ****         11.0f * M_PI / 6.0f, // 330
 194:Core/Src/main.c **** };
