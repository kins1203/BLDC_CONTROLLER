 256:USB_DEVICE/App/usbd_cdc_if.c ****   *         @note
 257:USB_DEVICE/App/usbd_cdc_if.c ****   *         This function will issue a NAK packet on any OUT packet received on
 258:USB_DEVICE/App/usbd_cdc_if.c ****   *         USB endpoint until exiting this function. If you exit this function
 259:USB_DEVICE/App/usbd_cdc_if.c ****   *         before transfer is complete on CDC interface (ie. using DMA controller)
 260:USB_DEVICE/App/usbd_cdc_if.c ****   *         it will result in receiving more data while previous ones are still
 261:USB_DEVICE/App/usbd_cdc_if.c ****   *         not sent.
 262:USB_DEVICE/App/usbd_cdc_if.c ****   *
 263:USB_DEVICE/App/usbd_cdc_if.c ****   * @param  Buf: Buffer of data to be received
 264:USB_DEVICE/App/usbd_cdc_if.c ****   * @param  Len: Number of data received (in bytes)
 265:USB_DEVICE/App/usbd_cdc_if.c ****   * @retval Result of the operation: USBD_OK if all operations are OK else USBD_FAIL
 266:USB_DEVICE/App/usbd_cdc_if.c ****   */
 267:USB_DEVICE/App/usbd_cdc_if.c **** static int8_t CDC_Receive_FS(uint8_t* Buf, uint32_t *Len)
 268:USB_DEVICE/App/usbd_cdc_if.c **** {
 269:USB_DEVICE/App/usbd_cdc_if.c ****   /* USER CODE BEGIN 6 */
 270:USB_DEVICE/App/usbd_cdc_if.c ****   if (*Len > 0)
 271:USB_DEVICE/App/usbd_cdc_if.c ****   {
 272:USB_DEVICE/App/usbd_cdc_if.c ****       uint32_t l = (*Len > CDC_RX_BUF_SIZE) ? CDC_RX_BUF_SIZE : *Len;
 273:USB_DEVICE/App/usbd_cdc_if.c ****       memcpy((void *)cdc_rx_buf, Buf, l);
 274:USB_DEVICE/App/usbd_cdc_if.c ****       cdc_rx_len = l;
ARM GAS  C:\Users\AD\AppData\Local\Temp\ccJC15oT.s 			page 7


 275:USB_DEVICE/App/usbd_cdc_if.c ****       cdc_rx_flag = 1;   // báo có lệnh mới
 276:USB_DEVICE/App/usbd_cdc_if.c ****   }
 277:USB_DEVICE/App/usbd_cdc_if.c ****   USBD_CDC_SetRxBuffer(&hUsbDeviceFS, &Buf[0]);
 278:USB_DEVICE/App/usbd_cdc_if.c ****   USBD_CDC_ReceivePacket(&hUsbDeviceFS);
 279:USB_DEVICE/App/usbd_cdc_if.c ****   return (USBD_OK);
 280:USB_DEVICE/App/usbd_cdc_if.c ****   /* USER CODE END 6 */
 281:USB_DEVICE/App/usbd_cdc_if.c **** }
