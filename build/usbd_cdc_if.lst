 292:USB_DEVICE/App/usbd_cdc_if.c ****   * @retval USBD_OK if all operations are OK else USBD_FAIL or USBD_BUSY
 293:USB_DEVICE/App/usbd_cdc_if.c ****   */
 294:USB_DEVICE/App/usbd_cdc_if.c **** uint8_t CDC_Transmit_FS(uint8_t* Buf, uint16_t Len)
 295:USB_DEVICE/App/usbd_cdc_if.c **** {
 296:USB_DEVICE/App/usbd_cdc_if.c ****   uint8_t result = USBD_OK;
